# Server-only. Required for streamed replies, messy-answer parsing, and ordinance search.
# Sent only to https://api.x.ai/v1. Never prefix this with NEXT_PUBLIC_.
XAI_API_KEY=
# Optional. Defaults to grok-4.7.
XAI_MODEL=

# Optional. Without these, projects stay in the browser and Save explains that.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

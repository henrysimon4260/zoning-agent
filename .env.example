# Optional build-time values. They are inlined into the static site.
# Do not put a secret model key here. Enter that in the app under Model;
# it stays in the browser.

# Default OpenAI-compatible base URL. Leave empty to use https://api.openai.com/v1.
NEXT_PUBLIC_LLM_BASE_URL=

# Optional. If these are empty, paste them into Model on the device instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
